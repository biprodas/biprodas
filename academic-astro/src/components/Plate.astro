---
// A generative "figure plate": a small plot seeded by the project id, so every
// project gets a stable, distinct illustration without needing screenshots.
interface Props {
  seed: string;
  /** Draw the outer border (off when the plate sits inside a card). */
  framed?: boolean;
  /** Extra classes, e.g. a different aspect ratio. */
  class?: string;
}
const { seed, framed = true, class: cls } = Astro.props;

let h = 2166136261;
for (const c of seed) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
const rand = () => {
  h = Math.imul(h ^ (h >>> 15), 2246822507);
  h = Math.imul(h ^ (h >>> 13), 3266489909);
  return ((h ^= h >>> 16) >>> 0) / 4294967296;
};

const W = 640, H = 280, pad = 34;
const series = (n: number, amp: number, drift: number) => {
  let y = H * (0.35 + rand() * 0.3);
  return Array.from({ length: n }, (_, i) => {
    y += (rand() - 0.5) * amp + drift;
    y = Math.max(pad, Math.min(H - pad, y));
    return [pad + (i * (W - pad * 2)) / (n - 1), y] as const;
  });
};
const a = series(24, 42, -2.2);
const b = series(24, 26, 1.1);
const path = (pts: readonly (readonly [number, number])[]) => pts.map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
const dots = Array.from({ length: 16 }, () => [pad + rand() * (W - pad * 2), pad + rand() * (H - pad * 2), 1.5 + rand() * 2.5] as const);
const mark = a[Math.floor(8 + rand() * 10)]!;
---
<div
  class:list={[
    "relative aspect-[16/6] overflow-hidden bg-paper bg-[linear-gradient(var(--rule)_1px,transparent_1px),linear-gradient(90deg,var(--rule)_1px,transparent_1px)] bg-size-[1.2rem_1.2rem]",
    { "border border-rule": framed },
    cls,
  ]}
  aria-hidden="true"
>
  <svg class="absolute inset-0 size-full" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
    <line x1={pad} y1={H - pad} x2={W - pad} y2={H - pad} stroke="var(--muted)" stroke-width="1" />
    <line x1={pad} y1={pad} x2={pad} y2={H - pad} stroke="var(--muted)" stroke-width="1" />
    {Array.from({ length: 9 }, (_, i) => <line x1={pad + (i * (W - pad * 2)) / 8} y1={H - pad} x2={pad + (i * (W - pad * 2)) / 8} y2={H - pad + 5} stroke="var(--muted)" />)}
    {dots.map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill="var(--muted)" opacity="0.35" />)}
    <path d={path(b)} fill="none" stroke="var(--muted)" stroke-width="1.4" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
    <path d={path(a)} fill="none" stroke="var(--pen)" stroke-width="2" vector-effect="non-scaling-stroke" />
    <circle cx={mark[0]} cy={mark[1]} r="5" fill="var(--paper)" stroke="var(--pen)" stroke-width="2" />
  </svg>
</div>
