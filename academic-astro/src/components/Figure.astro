---
import type { AcademicProject } from "../lib/data.ts";
import { fmtRange } from "../lib/dates.ts";
import Ph from "./Ph.astro";
import Plate from "./Plate.astro";
interface Props {
  project: AcademicProject;
  n: number;
  link?: boolean;
  plate?: boolean;
}
const { project: p, n, link = true, plate = true } = Astro.props;
const meta = [
  p.period ? fmtRange(p.period.start, p.period.end) : null,
  p.role,
  p.topics.slice(0, 3).join(", ") || null,
].filter(Boolean);
const href = `/projects/${p.id}/`;
---

<figure class="grid gap-2.5">
  {plate && <Plate seed={p.id} />}
  <figcaption class="text-[0.97rem]">
    <span class="mr-1 italic text-muted">Figure {n}.</span>
    <h3 class="inline text-[1.22rem] font-semibold">
      {
        link ? (
          <a href={href} class="text-ink no-underline hover:text-pen">
            {p.title}
          </a>
        ) : (
          p.title
        )
      }
    </h3>
    {
      p.summaryForResearch.value ? (
        <Ph f={p.summaryForResearch} tag="p" class="mt-1 text-ink-2">
          {p.summaryForResearch.value}
        </Ph>
      ) : (
        <p class="mt-1 text-ink-2">{p.summary}</p>
      )
    }
    {
      meta.length > 0 && (
        <div class="mt-1 flex flex-wrap gap-x-4 text-meta">
          {meta.map((m) => (
            <span>{m}</span>
          ))}
        </div>
      )
    }
    {
      p.openQuestions.value[0] && (
        <Ph f={p.openQuestions} tag="p" class="mt-2 border-l-2 border-pen pl-3 italic text-ink-2">
          {p.openQuestions.value[0]}
        </Ph>
      )
    }
  </figcaption>
</figure>
