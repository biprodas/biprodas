---
import type { Publication } from "../data/index.ts";
import { bibtex, statusLabel } from "../lib/cite.ts";
import { profile } from "../lib/data.ts";
interface Props {
  pub: Publication;
}
const { pub } = Astro.props;
const venue = [pub.venue, pub.volume && `vol. ${pub.volume}`, pub.issue && `no. ${pub.issue}`, pub.pages && `pp. ${pub.pages}`, pub.date?.slice(0, 4)].filter(Boolean).join(", ");
const links = [
  ...(pub.doi ? [{ label: "doi", url: `https://doi.org/${pub.doi}` }] : []),
  ...(pub.arxiv ? [{ label: "arXiv", url: `https://arxiv.org/abs/${pub.arxiv}` }] : []),
  ...pub.links.map((l) => ({ label: l.label ?? l.kind, url: l.url })),
];
---
<li class="citation grid grid-cols-[2.2rem_1fr]">
  <div>
    <div class="font-semibold">
      {pub.title}
      {pub.status !== "published" && <span class="ml-1.5 text-[0.8rem] font-normal italic text-pen">{statusLabel(pub.status)}</span>}
    </div>
    <div class="text-[0.95rem] text-ink-2">
      {
        pub.authors.map((a, i) => (
          <>
            <span class:list={{ "underline decoration-rule underline-offset-[0.2em]": a === profile.name }}>{a}</span>
            {i < pub.authors.length - 1 && ", "}
          </>
        ))
      }
    </div>
    {venue && <div class="text-[0.95rem] italic text-ink-2">{venue}</div>}
    <div class="mt-1 flex flex-wrap gap-x-4 gap-y-0.5 text-[0.9rem]">
      {links.map((l) => <a href={l.url}>{l.label}</a>)}
    </div>
    <details class="mt-1 text-[0.9rem]">
      <summary class="w-fit cursor-pointer text-pen">bibtex</summary>
      <pre class="mt-2 overflow-x-auto border border-rule bg-paper-2 px-3.5 py-3 font-mono text-[0.7rem] leading-[1.55] whitespace-pre text-ink-2">{bibtex(pub)}</pre>
    </details>
  </div>
</li>
