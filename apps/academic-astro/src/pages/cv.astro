---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Citation from "../components/Citation.astro";
import Ph from "../components/Ph.astro";
import { profile, education, experience, publications, teaching, awards, certifications, projects } from "../lib/data.ts";
import { fmtRange, fmtDate } from "../lib/dates.ts";

const loc = [profile.location?.city, profile.location?.country].filter(Boolean).join(", ");
const links = [profile.sites.academic, ...Object.values(profile.social)].map((u) => u.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, ""));
---
<Base title="CV" description={`Curriculum vitae of ${profile.name}.`}>
  <header>
    <p class="page-kicker no-print">Curriculum vitae</p>
    <h1 class="page-title">{profile.name}</h1>
    <Ph f={profile.headline} tag="p" class="hero-headline" style="font-size:1.15rem">{profile.headline.value}</Ph>
    <p class="mono muted" style="margin-top:.8rem;line-height:1.8">
      {profile.email} · {loc}<br />{links.join(" · ")}
    </p>
    <div class="btn-row no-print">
      <button class="btn primary" type="button" onclick="window.print()">Print / save as PDF</button>
      {profile.cv && <a class="btn" href={profile.cv}>Download PDF</a>}
    </div>
  </header>

  <Section n="1" title="Research interests">
    <Ph f={profile.interests} tag="p">{profile.interests.value.map((i) => i.topic).join(" · ")}</Ph>
  </Section>

  <Section n="2" title="Education">
    {education.map((e) => (
      <div class="entry">
        <h3 style="font-size:1.05rem">{e.degree.name}</h3>
        <div class="where">{e.institution.name} · {fmtRange(e.start, e.end)}</div>
        {e.thesisF.value && <Ph f={e.thesisF} tag="p" style="font-size:.93rem;margin-top:.3rem">{e.thesisF.value.kind[0]!.toUpperCase() + e.thesisF.value.kind.slice(1)}: <i>{e.thesisF.value.title}</i></Ph>}
      </div>
    ))}
  </Section>

  <Section n="3" title="Experience">
    <ul class="entries" style="gap:1.2rem">
      {experience.map((e) => (
        <li class="entry">
          <h3 style="font-size:1.05rem">{e.title}, {e.org.name}</h3>
          <div class="where">{fmtRange(e.start, e.end)}{e.org.location && ` · ${e.org.location.country}`}</div>
          {e.highlights[0] && <p style="font-size:.93rem;margin-top:.25rem">{e.highlights[0]}</p>}
        </li>
      ))}
    </ul>
  </Section>

  <Section n="4" title="Publications">
    <Ph f={publications} tag="ol" class="citations">{publications.value.map((p) => <Citation pub={p} />)}</Ph>
  </Section>

  <Section n="5" title="Selected projects">
    <ul class="compact">
      {projects.slice(0, 5).map((p) => (<li style="grid-template-columns:1fr"><div><b style="font-weight:500">{p.title}</b> <span class="sub">{p.summary}</span></div></li>))}
    </ul>
  </Section>

  <Section n="6" title="Teaching, awards & certifications">
    <ul class="compact">
      {teaching.map((t) => (<li><span class="mono">{t.start ? fmtDate(t.start).slice(-4) : "—"}</span><div>{t.title} <span class="sub">· {t.org.name}</span></div></li>))}
      {awards.map((a) => (<li><span class="mono">{a.date ?? "—"}</span><div>{a.title}{a.result && ` · ${a.result}`}</div></li>))}
      {certifications.map((c) => (<li><span class="mono">{fmtDate(c.issued)}</span><div>{c.title} <span class="sub">· {c.issuer}</span></div></li>))}
    </ul>
  </Section>
</Base>
