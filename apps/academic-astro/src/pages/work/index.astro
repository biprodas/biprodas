---
import Base from "../../layouts/Base.astro";
import Figure from "../../components/Figure.astro";
import { projects } from "../../lib/data.ts";
---
<Base title="Work" description="Systems I have built, written up as figures with the questions they raised.">
  <header>
    <p class="page-kicker">Work</p>
    <h1 class="page-title">Systems, <em>as figures</em></h1>
    <p class="lede">
      Each project is described like an experiment: the problem, what made it hard, and the question it left me with.
      Several were built for clients under NDA, so some have no public link.
    </p>
  </header>
  <div class="figures" style="margin-top:3.5rem">
    {projects.map((p, i) => <Figure project={p} n={i + 1} />)}
  </div>
</Base>
