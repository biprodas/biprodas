---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Sidenote from "../components/Sidenote.astro";
import Currently from "../components/Currently.astro";
import Ph from "../components/Ph.astro";
import { profile, paragraphs, awards } from "../lib/data.ts";

const story = paragraphs(profile.about.value);
const solved = awards.find((a) => a.kind === "achievement" && /problems/i.test(a.title));
const prof: Record<string, string> = {
  native: "native",
  "full-professional": "full professional",
  professional: "professional",
  "limited-working": "limited working",
  elementary: "elementary",
};
const principles = [
  ["Measure before believing.", "If a system matters, I want a number for how often it is wrong, and I want to know how that number was produced."],
  ["Invariants over heroics.", "The best production fix I made was a constraint that made a whole class of bug impossible."],
  ["Explain it to someone new.", "Mentoring taught me that if I cannot explain a design to a junior engineer, I do not yet understand it."],
];
---
<Base title="About" description={`About ${profile.name}: background, how I work, and what I care about.`}>
  <header>
    <p class="page-kicker">About</p>
    <h1 class="page-title">Hello, I’m <em>Biprodas</em>.</h1>
  </header>

  <Section n="1" title="The short story" id="story">
    <div class="margin-block"><Currently /></div>
    <Ph f={profile.about} tag="div" class="prose">
      {
        story.map((para, i) =>
          i === 0 && solved ? (
            <p class="dropcap">
              {para}
              <Sidenote n="1">{solved.title}. {solved.description}</Sidenote>
            </p>
          ) : (
            <p class:list={{ dropcap: i === 0 }}>{para}</p>
          ),
        )
      }
    </Ph>
  </Section>

  <Section n="2" title="How I work" id="principles">
    <ol class="interests">
      {principles.map(([h, p]) => (<li><div><h3>{h}</h3><p>{p}</p></div></li>))}
    </ol>
  </Section>

  {
    profile.languages.value.length > 0 && (
      <Section n="3" title="Languages" id="languages">
        <Ph f={profile.languages} tag="ul" class="contact-list">
          {profile.languages.value.map((l) => (<li><span class="mono">{prof[l.proficiency]}</span><span>{l.name}</span></li>))}
        </Ph>
      </Section>
    )
  }

  <Section n="4" title="Elsewhere" id="elsewhere">
    <p>
      This is my academic homepage. For the engineering side, case studies, products and code, see
      <a href={profile.sites.engineering}>{profile.sites.engineering.replace("https://", "")}</a> and
      <a href={profile.social.github}>GitHub</a>. Or write to me at <a href={`mailto:${profile.email}`}>{profile.email}</a>.
    </p>
  </Section>
</Base>
